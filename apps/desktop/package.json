{
  "name": "forbiden-desktop",
  "version": "0.1.0",
  "description": "FORBIDEN — Graph-based code IDE (Electron desktop app)",
  "main": "dist/main/index.js",
  "scripts": {
    "dev":     "electron-vite dev",
    "build":   "electron-vite build",
    "preview": "electron-vite preview",
    "start":   "npm run build && electron ."
  },
  "devDependencies": {
    "@types/node":             "^20.0.0",
    "@types/react":            "^18.3.0",
    "@types/react-dom":        "^18.3.0",
    "@vitejs/plugin-react":    "^4.3.0",
    "electron":                "^33.0.0",
    "electron-builder":        "^25.0.0",
    "electron-vite":           "^2.3.0",
    "typescript":              "^5.3.0",
    "vite":                    "^5.4.0"
  },
  "dependencies": {
    "react":                   "^18.3.0",
    "react-dom":               "^18.3.0",
    "@monaco-editor/react":    "^4.6.0"
  },
  "build": {
    "appId": "io.forbiden.desktop",
    "productName": "FORBIDEN",
    "directories": { "output": "release" },
    "linux": { "target": "AppImage" },
    "mac":   { "target": "dmg" },
    "win":   { "target": "nsis" }
  }
}
