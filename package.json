{
  "name": "forbiden",
  "version": "1.0.0",
  "private": true,
  "description": "FORBINDEN — Graph-based collaborative code IDE",
  "scripts": {
    "dev": "concurrently --names \"API,WEB\" --prefix-colors \"cyan,magenta\" \"bun --watch apps/api/src/server.ts\" \"npm run --prefix apps/web dev\"",
    "build": "npm run --prefix apps/web build",
    "install:all": "bun install --cwd apps/api && npm install --prefix apps/web --legacy-peer-deps",
    "db:push": "bun --cwd apps/api run db:push",
    "db:studio": "bun --cwd apps/api run db:studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
