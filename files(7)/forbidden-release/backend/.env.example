# ─── Required ──────────────────────────────────────────────────────────────────

MONGODB_URI=mongodb://localhost:27017/forbidden
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 48
JWT_SECRET=

# ─── Optional ──────────────────────────────────────────────────────────────────

CLIENT_ORIGIN=http://localhost:3000
PORT=3001

# Docker image for workspace containers
# Build with: docker build -f docker/Dockerfile.workspace -t forbidden/runtime:latest .
WORKSPACE_IMAGE=forbidden/runtime:latest

NODE_ENV=development

# ─── Observability (Phase 5) ───────────────────────────────────────────────────

# Set to true to export traces to OTLP endpoint (also enabled automatically in production)
OTEL_ENABLED=false

# OTLP collector endpoint (default: local Jaeger via docker compose --profile tracing up)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─── BullMQ Dashboard (Phase 5) ───────────────────────────────────────────────

# HTTP Basic Auth credentials for the BullBoard job queue dashboard
# Dashboard runs at http://localhost:3030 (docker compose --profile debug up)
BULLBOARD_USER=forbidden
BULLBOARD_PASS=changeme

# BullBoard embedded dashboard password (mounts at /admin/queues inside the API)
# Leave unset to disable the dashboard entirely
BULLBOARD_PASSWORD=

# ─── Phase 7 ──────────────────────────────────────────────────────────────────

# Maximum number of workspaces a single operator can create (default: 50)
MAX_WORKSPACES_PER_OPERATOR=50

# Maximum team size (default: 200 members)
MAX_TEAM_MEMBERS=200

# Phase 6 — AI Assistant (Gemini — free tier)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# Frontend URL for share links
PUBLIC_URL=http://localhost:5173
