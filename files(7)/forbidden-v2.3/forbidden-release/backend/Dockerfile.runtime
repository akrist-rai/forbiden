FROM ubuntu:22.04

# Install languages and tools that workspace containers need
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash curl git python3 python3-pip nodejs npm \
    build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Bun inside containers too
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:$PATH"

WORKDIR /workspace
CMD ["/bin/bash"]
